PORT=5055
# Copy the connection string from MongoDB Atlas, then replace the placeholders.
# URL-encode special characters in the password (for example, @ becomes %40).
MONGODB_URI=mongodb+srv://<db-username>:<db-password>@<cluster-host>/college_library?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4175,http://127.0.0.1:4175
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=library_auth
